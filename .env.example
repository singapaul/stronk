# --- Auth (required; the app refuses to start without them)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Bearer token for MCP clients that can send headers (Claude Code). >= 32 chars.
# Generate: openssl rand -hex 32
MCP_TOKEN=
# Secret URL segment for the Claude app's custom connector: https://<host>/mcp/<MCP_PATH_TOKEN>
# >= 32 chars and different from MCP_TOKEN, so either can be rotated alone.
MCP_PATH_TOKEN=

# --- Server
DB_PATH=./data/gym.db
PORT=3000
# Requests per window per credential type and client IP (failed logins count too).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_S=300

# --- Litestream (optional, container only). Leave LITESTREAM_BUCKET empty to disable.
# Cloudflare R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
