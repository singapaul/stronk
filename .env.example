# --- Auth (required; the app refuses to start without them)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Bearer token for MCP clients that can send headers (Claude Code). >= 32 chars.
# Generate: openssl rand -hex 32
MCP_TOKEN=
# Secret URL segment for the Claude app's custom connector: https://<host>/mcp/<MCP_PATH_TOKEN>
# >= 32 chars and different from MCP_TOKEN, so either can be rotated alone.
MCP_PATH_TOKEN=
# Optional: token for phone health sync (POST /api/bodyweight/import only). >= 32 chars, different from the MCP tokens.
INGEST_TOKEN=

# --- Server
DB_PATH=./data/gym.db
PORT=3000
# Requests per window per credential type and client IP (failed logins count too).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_S=300

# --- Litestream (optional, container only). Leave LITESTREAM_BUCKET empty to disable.
# Cloudflare R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Web app sign-in (optional; set all five or none). Without them the web app shows "sign-in isn't set up".
# Google Cloud Console → Credentials → OAuth client ID (Web application); redirect URI <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=
# Signs session cookies; >= 32 chars. Changing it signs everyone out. Generate: openssl rand -hex 32
SESSION_SECRET=
# Where the app is served, e.g. https://stronk.fly.dev (or http://localhost:3000 locally)
PUBLIC_URL=

# Local development only (ignored when NODE_ENV=production): /auth/dev signs in as this email.
DEV_LOGIN_EMAIL=
